# Autonomous Support Agent Configuration
APP_NAME="Autonomous Support Agent"
ENV="development"
DEBUG=true

# Database (SQLite default for zero-friction setup, supports Postgres)
DATABASE_URL="sqlite+aiosqlite:///./support_agent.db"

# Checkpointer Engine (supports 'memory', 'sqlite', 'postgres' for horizontal scaling)
CHECKPOINTER_TYPE="memory"
CHECKPOINTER_DB_PATH="./checkpoints.db"
POSTGRES_CHECKPOINTER_URL=""

# CRM & Helpdesk Integration (Zendesk / Salesforce)
CRM_PROVIDER="mock"
CRM_API_URL=""
CRM_API_KEY=""

# Governance & Limits
MAX_AUTONOMOUS_REFUND_AMOUNT=50.0
REFUND_WINDOW_DAYS=30
NEGATIVE_SENTIMENT_THRESHOLD=-0.60
MAX_CONSECUTIVE_TOOL_FAILURES=2
MAX_CONVERSATION_TURNS=12

# LLM Provider (Optional: if empty or MOCK_LLM_MODE=true, uses built-in deterministic MockSupportLLM)
MOCK_LLM_MODE=false
OPENAI_API_KEY=""
MODEL_NAME="gpt-4o-mini"
